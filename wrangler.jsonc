{
  // At the repository root rather than beside the site in docs/, because that is
  // where the deploy runs. With no config here, wrangler finds the SDK's pnpm
  // workspace and refuses to guess which application it is meant to ship.
  "name": "ai-oauth-sdk-docs",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./docs/build/client",
    "html_handling": "auto-trailing-slash",
    // Not `single-page-application`. Every page is prerendered to its own HTML,
    // and that setting would answer an unknown URL with the HTML built for `/`,
    // which carries that route's data and hydrates against the wrong one.
    "not_found_handling": "none"
  }
}

{
  // Cloudflare Workers Builds deploys this site. The config lives here rather
  // than only in the dashboard so the deploy is reviewable, and so the asset
  // settings below cannot be changed by accident.
  //
  // There is no `main`: this is a static site, so the Worker is nothing but its
  // assets. The build command, the root directory and the Node version are
  // dashboard settings, and `docs/README.md` records what they need to be.
  "name": "ai-oauth-sdk-docs",
  "compatibility_date": "2026-08-01",
  "assets": {
    // `pnpm build` prerenders every page into here. `build/server` is not
    // deployed: the site is built with `ssr: false`, so there is nothing to run.
    "directory": "./build/client",

    // Serves `/docs/quick-start/index.html` for `/docs/quick-start`, which is
    // the layout the prerender writes.
    "html_handling": "auto-trailing-slash",

    // Deliberately not `single-page-application`.
    //
    // Every page is prerendered to its own HTML, so the SPA rewrite is not
    // needed to serve them, and it would answer an unknown URL with the HTML
    // prerendered for `/`. That HTML carries `/`'s route data, so it hydrates
    // against the wrong route and fails.
    //
    // `404-page` was the other candidate, using React Router's
    // `__spa-fallback.html`. Tried it: the shell hydrates, asks for route data
    // that is not there, and renders "Something went wrong" rather than the
    // site's own not-found page. A plain 404 is more honest than that.
    "not_found_handling": "none"
  }
}

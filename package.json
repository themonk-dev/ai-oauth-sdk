{
  "name": "ai-oauth-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for ai-oauth-sdk \u2014 provider-agnostic OAuth for AI CLIs and apps.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "clean": "pnpm -r exec rm -rf dist .turbo && rm -rf node_modules",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "pnpm build && changeset publish",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm verify:exports",
    "verify:exports": "node scripts/verify-exports.mjs",
    "docs:install": "pnpm --dir docs install",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:start": "pnpm --dir docs start",
    "docs:typecheck": "pnpm --dir docs typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}

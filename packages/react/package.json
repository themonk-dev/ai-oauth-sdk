{
  "name": "@ai-oauth-sdk/react",
  "version": "1.0.0",
  "description": "React bindings for ai-oauth-sdk: useAuth hook and provider for ChatGPT/Claude/Gemini/Grok sign-in.",
  "keywords": [
    "oauth",
    "pkce",
    "react",
    "hooks",
    "ai",
    "chatgpt",
    "claude"
  ],
  "license": "MIT",
  "homepage": "https://ai-oauth.themonk.dev",
  "bugs": {
    "url": "https://github.com/themonk-dev/ai-oauth-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themonk-dev/ai-oauth-sdk.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@ai-oauth-sdk/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "@types/node": "^22.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "name": "@ai-oauth-sdk/react-native",
  "version": "0.3.0",
  "description": "React Native / Expo adapter for ai-oauth-sdk: deep-link and auth-session receivers plus secure token storage.",
  "keywords": [
    "oauth",
    "pkce",
    "react-native",
    "expo",
    "ai",
    "deep-link"
  ],
  "license": "MIT",
  "homepage": "https://ai-oauth.themonk.dev/docs/runtimes/react-native",
  "bugs": {
    "url": "https://github.com/themonk-dev/ai-oauth-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themonk-dev/ai-oauth-sdk.git",
    "directory": "packages/react-native"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-oauth-sdk/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

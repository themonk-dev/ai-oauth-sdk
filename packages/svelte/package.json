{
  "name": "@ai-oauth-sdk/svelte",
  "version": "0.3.0",
  "description": "Svelte store for ai-oauth-sdk. Sign in with ChatGPT, Claude, Gemini or Grok.",
  "keywords": [
    "oauth",
    "pkce",
    "svelte",
    "store",
    "ai",
    "chatgpt",
    "claude"
  ],
  "license": "MIT",
  "homepage": "https://ai-oauth.themonk.dev/docs/frameworks/svelte",
  "bugs": {
    "url": "https://github.com/themonk-dev/ai-oauth-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themonk-dev/ai-oauth-sdk.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-oauth-sdk/core": "workspace:^"
  },
  "peerDependencies": {
    "svelte": ">=4"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

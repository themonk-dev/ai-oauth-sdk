{
  "name": "@ai-oauth-sdk/node",
  "version": "0.3.0",
  "description": "Node/Bun/Deno adapter for ai-oauth-sdk: loopback callback server, file-backed token storage, and browser launching.",
  "keywords": [
    "oauth",
    "pkce",
    "cli",
    "ai",
    "node",
    "loopback"
  ],
  "license": "MIT",
  "homepage": "https://ai-oauth.themonk.dev/docs/runtimes/node",
  "bugs": {
    "url": "https://github.com/themonk-dev/ai-oauth-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themonk-dev/ai-oauth-sdk.git",
    "directory": "packages/node"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-oauth-sdk/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
